{
  "name": "ttoksem",
  "version": "0.2.2",
  "description": "Local-first cost ledger for AI usage — track Claude Code, Codex, and OpenAI token spend per task.",
  "keywords": [
    "ai",
    "llm",
    "tokens",
    "usage",
    "cost",
    "ledger",
    "claude",
    "claude-code",
    "codex",
    "openai",
    "cli"
  ],
  "license": "MIT",
  "author": "johwanghee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttoksem/ttoksem.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ttoksem/ttoksem#readme",
  "bugs": "https://github.com/ttoksem/ttoksem/issues",
  "type": "module",
  "bin": { "ttoksem": "./dist/cli.mjs" },
  "files": ["dist/cli.mjs"],
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "pnpm --filter ttoksem... build && node esbuild.mjs",
    "prepublishOnly": "pnpm build:bundle",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@ttoksem/core": "workspace:*",
    "@ttoksem/http": "workspace:*",
    "@ttoksem/ledger-http": "workspace:*",
    "@ttoksem/providers": "workspace:*",
    "@ttoksem/schema": "workspace:*",
    "@ttoksem/server": "workspace:*",
    "@ttoksem/storage-sqlite": "workspace:*",
    "@types/node": "^22.15.2",
    "commander": "^14.0.2",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
