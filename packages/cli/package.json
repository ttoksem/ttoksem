{
  "name": "@ttoksem/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "ttoksem": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ttoksem/core": "workspace:*",
    "@ttoksem/providers": "workspace:*",
    "@ttoksem/schema": "workspace:*",
    "@ttoksem/server": "workspace:*",
    "@ttoksem/storage-sqlite": "workspace:*",
    "commander": "^14.0.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
